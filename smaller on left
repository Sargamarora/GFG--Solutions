class Solution {
    public int[] leftSmaller(int[] arr) {
        // code here
        int j = 0 ;
        int [] result = new int [arr.length];
        Stack<Integer> stack = new Stack<>();
        for( int i = 0 ; i< arr.length ;i++){
            if(stack.isEmpty()){
                result[j++]=-1;
                stack.push(arr[i]);
            }
            else {
            while(!stack.isEmpty() && stack.peek()>=arr[i]){
                stack.pop();
            }
            result[j++]= stack.isEmpty()?-1:stack.peek();
            stack.push(arr[i]);
            }
        }
        return result;
    }
}
