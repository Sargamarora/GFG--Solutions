// problem : reverse a stack
// User function Template for Java

class Solution {
    static void reverse(Stack<Integer> s) {
        // add your code here
        if(s.isEmpty()) return;
        int top=s.pop();
        reverse(s);
        insertatbottom(top,s);
    }
    static void insertatbottom( int topval , Stack<Integer> s){
        if(s.isEmpty()){
            s.push(topval);
            return;
        }
        int top = s.pop();
        insertatbottom(topval,s);
        s.push(top);
    }
}
