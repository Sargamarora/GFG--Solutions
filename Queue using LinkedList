
class MyQueue {
    QueueNode front, rear;

    // Function to push an element into the queue.
    void push(int a) {
        // code here
        QueueNode newnode = new QueueNode(a);
        if(front==null){
            front=rear=newnode;
        }
        else {
            
        rear.next=newnode;
        rear=newnode;
        
        }
    }

    // Function to pop front element from the queue
    int pop() {

        if(front==null) return -1;
        
        // code here
        int val = front.data;
        front=front.next;
        return val;
    }
}
