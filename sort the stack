class GfG {
    public Stack<Integer> sort(Stack<Integer> s) {
        // add code here.
    helper(s);
    return s;
    }
    public void helper(Stack<Integer> s){
         if(s.isEmpty()) return ;
        int top = s.pop();
        helper(s);
        dosort(top,s);
    }
    public void dosort( int topval , Stack<Integer> s){
        if(s.isEmpty()|| s.peek()<topval) {
            s.push(topval);
            return;
        }
        int top = s.pop();
        dosort(topval,s);
        s.push(top);
        
        
    }
}
